{
  "name": "@app/shared-types",
  "type": "module",
  "main": "./src/message.ts",
  "types": "./src/message.ts",
  "exports": {
    ".": "./src/message.ts",
    "./grpc": "./src/grpc.ts"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.2.3",
    "@grpc/grpc-js": "^1.14.4"
  },
  "devDependencies": {
    "grpc-tools": "^1.13.1",
    "ts-proto": "^2.12.0"
  },
  "scripts": {
    "proto:gen": "pnpm proto:gen:messages && pnpm proto:gen:grpc",
    "proto:gen:messages": "grpc_tools_node_protoc --ts_proto_out=./src/generated/messages --ts_proto_opt=outputServices=none,oneof=unions,esModuleInterop=true,env=node --proto_path=../proto ../proto/simulation.proto",
    "proto:gen:grpc": "grpc_tools_node_protoc --ts_proto_out=./src/generated/grpc --ts_proto_opt=outputServices=grpc-js,oneof=unions,esModuleInterop=true,env=node --proto_path=../proto ../proto/simulation.proto"
  }
}
